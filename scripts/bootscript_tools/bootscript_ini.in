
	echo "  Apply ini config"
	load $$devtype $$devnum:2 $$ini_addr_r config.ini
	ini generic $$ini_addr_r

	fdt addr $$fdt_addr_r
	fdt resize $$overlays_resize

	for overlay in $$overlays; do
		load $$devtype $$devnum:2 $$dtbo_addr_r amlogic/overlays/${_target_board}/$$overlay.dtbo
		fdt apply $$dtbo_addr_r

		ini $$overlay $$ini_addr_r
	done
