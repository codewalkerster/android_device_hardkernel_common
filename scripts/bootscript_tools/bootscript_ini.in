
	echo "  Apply ini config"
	load $$devtype $$devnum:$$fat_index $$ini_addr_r config.ini
	ini generic $$ini_addr_r

	fdt addr $$fdt_addr_r
	fdt resize $$overlays_resize

	for overlay in $$overlays; do
		load $$devtype $$devnum:$$fat_index $$dtbo_addr_r amlogic/overlays/${_target_board}/$$overlay.dtbo
		fdt apply $$dtbo_addr_r

		ini $$overlay $$ini_addr_r
	done

#force_hpd
if test $${force_hpd} = true; then
	setenv bootargs $${bootargs} aml_media.force_hpd=1
else
	setenv bootargs $${bootargs} aml_media.force_hpd=0
fi

#displaymode_option
	test -n $${displaymode_option} && test -n $${displaymode} && setenv displaymode $${displaymode}:$${displaymode_option}
#video-timing
	test -n $${video-timing} && setenv bootargs $${bootargs} aml_drm.modeline=$${video-timing}
#displaymode
	test -n $${displaymode} && setenv bootargs $${bootargs} aml_drm.displaymode=$${displaymode}
