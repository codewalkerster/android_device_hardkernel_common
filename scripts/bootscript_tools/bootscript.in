setenv bootlabel "Android 14"

echo "Start boot.scr booting."

run storeargs;

setenv bootargs $${bootargs} console=ttyS0,$${baudrate}
setenv bootargs $${bootargs} vendor.serialno=$${serial#}

echo "  Init default values"

test -n "$$lcd_density" || setenv lcd_density 240

setenv ini_addr_r 0x40010000
setenv fdt_addr_r 0x01000000
setenv dtbo_addr_r 0x40200000

setenv overlays ""
setenv overlays_resize 16384

setenv devtype mmc
setenv devnum 1


setenv fat_partitions 1 2 3

for idx in $$fat_partitions; do
	if fatinfo $$devtype $$devnum:$$idx; then
		setenv fat_index $$idx;
	fi;
done;

setenv boot_mode non

# read boot state from bcb.
if bcb load $$devnum misc; then
	# valid BCB found
	if bcb test command = bootonce-bootloader; then
		# Bootloader boot
		setenv boot_mode bootloader
		bcb clear command; bcb store;
	elif bcb test command = boot-recovery; then
		# Recovery boot
		setenv boot_mode recovery
	else
		# Normal boot
		echo "  Normal boot"
	fi
fi

# read boot state from reboot_mode.
if test $${boot_mode} = non; then
	get_rebootmode

	if test $${reboot_mode} = factory_reset; then
		setenv boot_mode recovery
	elif test $${reboot_mode} = fastboot; then
		setenv boot_mode bootloader
	else
		# Normal boot
		echo "  reboot_mode - $${reboot_mode}"
	fi
fi

if test $${boot_mode} = bootloader; then
	echo "  Go bootloader fastboot Mode"
	fastboot 0
fi;

${_load_dtb}
if test $${boot_mode} = recovery; then
	echo "  Go Recovery Mode"
	setenv recovery_mode true;
	setenv bootargs $${bootargs} $${fs_type} aml_dt=$${aml_dt};
else
	echo "  Go Normal Boot Mode"
${_load_ini}
	setenv bootconfig $${bootconfig} androidboot.force_normal_boot=1;
	setenv bootconfig $${bootconfig} androidboot.rollback=$${rollback_flag};
fi;

if test ${_active_slot} = normal; then
	echo "  Try normal boot"
	setenv active_slot normal
	setenv slot-suffixes -1
	setenv boot_part boot

	if imgread kernel $${boot_part} $${loadaddr}; then
		bootm $${loadaddr};
	fi;
	
	# read dtb from boot_part
	imgread dtb $${boot_part} $${dtb_mem_addr}
	bootm $${loadaddr}
fi

setenv bootconfig_a $${bootconfig} androidboot.slot_suffix=_a
setenv bootconfig_b $${bootconfig} androidboot.slot_suffix=_b

setenv tries 1 2 3
for try in $$tries; do
	ab_select active_slot $$devtype $$devnum#misc
	echo "  Try $${active_slot} slot boot"

	if test $${active_slot} = a; then;
		setenv active_slot _a
		setenv slot-suffixes 0
		setenv boot_part boot_a
	setenv bootconfig $${bootconfig_a}
	fi;
	if test $${active_slot} = b; then;
		setenv active_slot _b
		setenv slot-suffixes 1
		setenv boot_part boot_b
	setenv bootconfig $${bootconfig_b}
	fi;

	#setenv bootconfig $${bootconfig_a}
	
	if imgread kernel $${boot_part} $${loadaddr}; then
		bootm $${loadaddr};
	fi;
done
	
# read dtb from boot_part
imgread dtb $${boot_part} $${dtb_mem_addr}
bootm $${loadaddr}

# do not reach here.
echo try upgrade as booting failure;
check_ab;
run update;
