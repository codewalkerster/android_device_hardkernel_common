package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "device_amlogic_common_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["device_amlogic_common_license"],
}

filegroup {
    name: "audio_policy_configuration",
    srcs: ["audio_policy_configuration_temp.xml"],
}
prebuilt_etc {
    name: "audio_policy_configuration.xml",
    vendor: true,
    src: ":audio_policy_configuration",
}

