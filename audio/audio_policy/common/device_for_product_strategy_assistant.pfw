					wired_headphone = 0
					bluetooth_a2dp_speaker = 0
					bluetooth_a2dp_headphones = 0
					bluetooth_a2dp = 1
					hearing_aid = 0
					remote_submix = 0
					line = 0

			conf: BluetoothA2dpHeadphone
