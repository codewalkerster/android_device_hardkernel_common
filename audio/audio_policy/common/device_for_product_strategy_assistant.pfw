supDomain: DeviceForProductStrategy
	supDomain: Assistant
		domain: Device2
			conf: RemoteSubmix
				AvailableOutputDevices Includes RemoteSubmix
				AvailableOutputDevicesAddresses Includes 0

				component: /Policy/policy/product_strategies/assistant/selected_output_devices/mask
					speaker = 0
					hdmi = 0
					dgtl_dock_headset = 0
					anlg_dock_headset = 0
					usb_device = 0
					usb_accessory = 0
					usb_headset = 0
