					anlg_dock_headset = 0
					usb_device = 0
					usb_accessory = 0
					usb_headset = 0
					wired_headset = 0
					wired_headphone = 0
					bluetooth_a2dp_speaker = 1
					bluetooth_a2dp_headphones = 0
					bluetooth_a2dp = 0
					hearing_aid = 0
