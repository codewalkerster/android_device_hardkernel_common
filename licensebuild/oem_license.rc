on init
    # Mount tmpfs
    wait /dev/audio_utils
    wait /dev/dolby_fw 2
    wait /odm/lib/ms12 2
    mount tmpfs tmpfs /odm/lib/ms12 size=10240K,context=u:object_r:dolbyms12:s0 rw

    # Extracting the Dolby MS12 library
    exec - root root -- /vendor/bin/dolby_fw_dolbyms12 /oem/lib/ms12/libdolbyms12.so /odm/lib/ms12/libdolbyms12.so

    chmod 644 /odm/lib/ms12/libdolbyms12.so

    # changing access permission of the dev node used by android.hardware.audio.service-droidlogic
    chown audioserver mediadrm /dev/audio_utils
    chmod 644 /dev/audio_utils

    # Changing access permission of the dev node used by libdolbyms12
    chown audioserver mediadrm /dev/dolby_fw
    chmod 440 /dev/dolby_fw

    # Make the partition readable and writable
    mount tmpfs tmpfs /odm/lib/ms12 remount rw
