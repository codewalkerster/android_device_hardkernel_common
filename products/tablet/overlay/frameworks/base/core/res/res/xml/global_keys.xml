<global_keys version="1">
    <!-- Example format: id = keycode to handle globally. component = component which will handle
         this key. -->
    <key keyCode="KEYCODE_F1" component="com.droidlogic/.GlobalKeyReceiver" dispatchWhenNonInteractive="true" />
    <key keyCode="KEYCODE_F2" component="com.droidlogic/.GlobalKeyReceiver" dispatchWhenNonInteractive="true" />
    <key keyCode="KEYCODE_F3" component="com.droidlogic/.GlobalKeyReceiver" dispatchWhenNonInteractive="true" />
    <key keyCode="KEYCODE_F4" component="com.droidlogic/.GlobalKeyReceiver" dispatchWhenNonInteractive="true" />
    <key keyCode="KEYCODE_SETTINGS" component="com.droidlogic/.GlobalKeyReceiver" />
    <key keyCode="KEYCODE_PAIRING" component="com.droidlogic/.GlobalKeyReceiver" />
    <key keyCode="KEYCODE_F6" component="com.droidlogic/.GlobalKeyReceiver" />
    <key keyCode="KEYCODE_BUTTON_3" component="com.droidlogic/.GlobalKeyReceiver" />
    <key keyCode="KEYCODE_BUTTON_4" component="com.droidlogic/.GlobalKeyReceiver" dispatchWhenNonInteractive="true" />
    <key keyCode="KEYCODE_BUTTON_6" component="com.droidlogic/.GlobalKeyReceiver" />
    <key keyCode="KEYCODE_BUTTON_7" component="com.droidlogic/.GlobalKeyReceiver" />
    <key keyCode="KEYCODE_TV_INPUT" component="com.droidlogic/.GlobalKeyReceiver" />
</global_keys>
