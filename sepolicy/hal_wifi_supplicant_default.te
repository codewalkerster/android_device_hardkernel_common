allow hal_wifi_supplicant_default proc_net:file rw_file_perms;
allow hal_wifi_supplicant_default proc_modules:file { read open getattr};
allow hal_wifi_supplicant_default dumpstate:fd { use };
allow hal_wifi_supplicant_default dumpstate:fifo_file { write };
set_prop(hal_wifi_supplicant_default, vendor_wifi_prop)
