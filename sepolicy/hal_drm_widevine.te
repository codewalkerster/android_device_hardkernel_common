# Partner specific policies go here.
type hal_drm_widevine, domain;
type hal_drm_widevine_exec, vendor_file_type, exec_type, file_type;
init_daemon_domain(hal_drm_widevine)
hal_server_domain(hal_drm_widevine, hal_drm)
allow hal_drm_widevine mediadrm_vendor_data_file:file create_file_perms;
allow hal_drm_widevine mediadrm_vendor_data_file:dir create_dir_perms;
allow hal_drm_widevine drm_device:chr_file { read open write ioctl };
allow hal_drm_widevine self:capability sys_nice;
get_prop(hal_drm_widevine, vendor_media_prop)
get_prop(hal_drm_widevine, vendor_security_patch_level_prop)
