allow hal_fastboot_default block_device:dir search;
allow hal_fastboot_default kmsg_device:chr_file write;
allow hal_fastboot_default proc_bootconfig:file { getattr open read };
allow hal_fastboot_default proc_cmdline:file { getattr open read };
allow hal_fastboot_default rootfs:dir read;
allow hal_fastboot_default sysfs_dt_firmware_android:dir search;
allow hal_fastboot_default sysfs_dt_firmware_android:file { getattr open read };
allow hal_fastboot_default kmsg_device:chr_file open;
allow hal_fastboot_default sda_block_device:blk_file { getattr ioctl open write };
