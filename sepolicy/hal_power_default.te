allow hal_power_default sysfs_mpgpu:file rw_file_perms;
allow hal_power_default sysfs_mpgpu:dir search;
allow hal_power_default { sysfs_power sysfs_wakeup }:file { read write open };

allow hal_power_default sysfs:file { write open };

allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;
