#type current_service, domain;
type current_service, domain;
type current_service_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(current_service)
allow current_service console_device:chr_file { getattr ioctl read write };
#allow current_service default_prop:file { getattr map open read };
#allow current_service default_prop:file read;
allow current_service sysfs_devices_system_cpu:file write;
#set prop
allow current_service init:unix_stream_socket connectto;
allow current_service property_socket:sock_file write;
allow current_service vendor_media_prop:property_service set;
#set aisr_en
allow current_service sysfs_video:dir search;
allow current_service sysfs_video:file { open write };