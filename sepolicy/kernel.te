allow kernel self:capability mknod;
#allow kernel device:blk_file { ioctl read write create getattr setattr unlink };
allow kernel device:dir {rw_file_perms rw_dir_perms write create rmdir };
allow kernel device:chr_file { getattr setattr create unlink };

allow kernel sda_block_device:blk_file relabelto;
allow kernel super_block_device:blk_file relabelto;
allow kernel super_block_device:lnk_file relabelto;

allow kernel device:blk_file { getattr };
allow kernel { super_block_device sda_block_device }:blk_file { create getattr setattr unlink };
allow kernel vendor_file:file { getattr read open };
