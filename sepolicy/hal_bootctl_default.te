allow hal_bootctl_default rootfs:file {read open getattr};
allow hal_bootctl_default proc:file { open read getattr};
allow hal_bootctl_default block_device:dir search;
allow hal_bootctl_default misc_block_device:blk_file {read open write};

allow hal_bootctl_default sysfs_dt_firmware_android:dir { open read search };
allow hal_bootctl_default sysfs_dt_firmware_android:file { getattr open read };

allow hal_bootctl_default proc_cmdline:file read;

allow hal_bootctl_default env_device:blk_file rw_file_perms;
allow hal_bootctl_default kmsg_device:chr_file rw_file_perms;

get_prop(hal_bootctl_default, vendor_default_prop)
get_prop(hal_bootctl_default, usb_control_prop)

allow hal_bootctl_default { boot_block_device sda_block_device }:blk_file rw_file_perms;

allow hal_bootctl_default bootloader_device:blk_file rw_file_perms;

allow hal_bootctl_default sysfs:dir { open read };
#allow hal_bootctl_default sysfs:file { getattr open read };

allow hal_bootctl_default sysfs_tee:dir { search open read };
allow hal_bootctl_default sysfs_tee:file rw_file_perms;
allow hal_bootctl_default property_socket:sock_file write;
allow hal_bootctl_default init:unix_stream_socket connectto;
allow hal_bootctl_default powerctl_prop:property_service set;

allow hal_bootctl_default tmpfs:dir { write add_name };
allow hal_bootctl_default tmpfs:file { create write open read };
allow hal_bootctl_default block_device:dir { write remove_name add_name };
allow hal_bootctl_default block_device:lnk_file { create unlink };
allow hal_bootctl_default cert_device:chr_file { open read write ioctl };

allow hal_bootctl_default system_control:binder { call transfer };
allow hal_bootctl_default systemcontrol_hwservice:hwservice_manager { find };
allow hal_bootctl_default dumpstate:binder { call };
allow hal_bootctl_default dumpstate:fd { use };
allow hal_bootctl_default dumpstate:fifo_file { write };
